# ── Runtime ──────────────────────────────────────────────────────────────────
ENV=development                 # development | test | production (production hides /docs)
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────────────────────
# Leave both empty for a local SQLite file (./orchestrix.db).
# Supabase: Project Settings → Database → connection string (pooler, port 6543).
SUPABASE_DB_URL=
# Any SQLAlchemy URL; postgres:// and postgresql:// are mapped to psycopg 3 automatically.
DATABASE_URL=

# ── Supabase auth ────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=           # service_role key (server only — never ship to the browser)
# Only for legacy projects that still sign user JWTs with HS256. Projects using
# asymmetric signing keys are verified via JWKS and need nothing here.
SUPABASE_JWT_SECRET=

# ── HTTP ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=                   # comma-separated; defaults to FRONTEND_URL + localhost

# ── LLM (Groq) ───────────────────────────────────────────────────────────────
GROQ_API_KEY=                   # empty → extractive summaries, no LLM calls
GROQ_MODEL=llama-3.1-8b-instant
GROQ_RATE_LIMIT_RPM=30
GROQ_MAX_CONCURRENCY=3

# ── Orchestration / discovery ────────────────────────────────────────────────
ORCHESTRATOR_PLANNER=static      # static | llm
SUMMARIZE_TOP_N=10
SEMANTIC_SCHOLAR_API_KEY=       # strongly recommended: anonymous access is heavily rate-limited
OPENALEX_MAILTO=                # your contact e-mail → OpenAlex "polite pool"

# ── Scheduler ────────────────────────────────────────────────────────────────
ENABLE_SCHEDULER=true            # true on exactly ONE process/replica
